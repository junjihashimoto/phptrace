# Load generator: oha (Rust HTTP benchmarking tool) with JSON output.
FROM debian:bookworm-slim
ARG OHA_VERSION=v1.15.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl jq \
    && curl -fsSL -o /usr/local/bin/oha \
       "https://github.com/hatoo/oha/releases/download/${OHA_VERSION}/oha-linux-arm64" \
    && chmod +x /usr/local/bin/oha \
    && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
ENTRYPOINT ["/bin/sh"]
