# Like Dockerfile.bpftime but with the LLVM JIT backend (-DBPFTIME_LLVM_JIT=ON)
# so the eBPF program runs as native arm64 code instead of the ubpf interpreter.
# Produces the same /opt/bpftime/ + /opt/percall/ layout; select at runtime with
# BPFTIME_VM_NAME=llvm.
FROM php:8.3-fpm AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates cmake make gcc g++ pkg-config \
      clang llvm libbpf-dev \
      libelf-dev zlib1g-dev libboost-all-dev binutils-dev libyaml-cpp-dev \
      libncurses-dev \
      llvm-19-dev libclang-19-dev libpolly-19-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /bpftime
ARG BPFTIME_REF=master
RUN git clone --recursive --depth 1 --branch "${BPFTIME_REF}" \
      https://github.com/eunomia-bpf/bpftime.git . \
    && cmake -Bbuild -DCMAKE_BUILD_TYPE=RelWithDebInfo \
         -DBPFTIME_LLVM_JIT=ON \
         -DLLVM_DIR=/usr/lib/llvm-19/lib/cmake/llvm \
         -DBUILD_BPFTIME_DAEMON=0 \
         -DBPFTIME_ENABLE_UNIT_TESTING=0 \
    && cmake --build build --config RelWithDebInfo -j"$(nproc)"
RUN mkdir -p /out && \
    find /bpftime/build -name 'libbpftime-syscall-server.so' -exec cp {} /out/ \; && \
    find /bpftime/build -name 'libbpftime-agent.so' -exec cp {} /out/ \; && \
    { find /bpftime/build -name 'libbpftime-agent-transformer.so' -exec cp {} /out/ \; || true; } && \
    ls -l /out && echo "--- agent ldd ---" && ldd /out/libbpftime-agent.so || true

WORKDIR /percall
COPY Makefile percall.bpf.c percall_load.c ./
RUN make

FROM php:8.3-fpm
RUN docker-php-ext-install pdo_mysql mysqli opcache >/dev/null
RUN apt-get update && apt-get install -y --no-install-recommends \
      libboost-all-dev libyaml-cpp-dev libelf1 zlib1g libbpf1 \
      libllvm19 \
    && rm -rf /var/lib/apt/lists/*
COPY fpm-bench.conf /usr/local/etc/php-fpm.d/zz-bench.conf
COPY --from=build /out/ /opt/bpftime/
COPY --from=build /percall/percall_load /percall/percall.bpf.o /opt/percall/
COPY bpftime-entry.sh /opt/bench/bpftime-entry.sh
RUN chmod +x /opt/bench/bpftime-entry.sh
ENV BPF_OBJ=/opt/percall/percall.bpf.o
ENV PHPFPM_BIN=/usr/local/sbin/php-fpm
ENV BPFTIME_DIR=/opt/bpftime
ENV BPFTIME_VM_NAME=llvm
ENTRYPOINT ["/opt/bench/bpftime-entry.sh"]
